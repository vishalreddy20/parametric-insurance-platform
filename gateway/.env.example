# Set these as process environment variables. The gateway does not load dotenv files.
PARASHIELD_GATEWAY_CONFIG=/path/to/generated/gateway-config.json
PARASHIELD_GATEWAY_STATE_DIR=/path/to/persistent/ledger-data/gateway
PARASHIELD_JWT_KEY=replace-with-32-random-bytes-hex-encoded
PARASHIELD_PII_SALT_KEY=replace-with-a-separate-32-random-bytes-hex-encoded
PARASHIELD_GATEWAY_PORT=8080
PARASHIELD_GATEWAY_HOST=127.0.0.1
# PARASHIELD_ORIGIN=http://localhost:5173
# PARASHIELD_UPI_URL=http://localhost:8082
# PARASHIELD_UPI_AUTHORIZATION=replace-with-simulated-service-authorization
