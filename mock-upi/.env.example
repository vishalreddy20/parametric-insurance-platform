# Set as process environment variables.
PARASHIELD_GATEWAY_URL=http://127.0.0.1:8080
PARASHIELD_BANK_ACCESS_CODE=replace-with-the-simulated-bank-access-code
PARASHIELD_UPI_AUTHORIZATION=replace-with-a-random-service-authorization
PARASHIELD_UPI_STATE_DIR=/path/to/persistent/ledger-data/mock-upi
PARASHIELD_UPI_PORT=8082
PARASHIELD_UPI_FAILURE_BPS=0
PARASHIELD_UPI_LATENCY_MS=100
